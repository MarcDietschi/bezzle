    "Or a folder: a picture a cell" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder einen Ordner: ein Bild pro Zelle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou un dossier : une image par cellule"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O una cartella: un’immagine per cella"
          }
        }
      }
    },
    "Or drag the shadow itself on the canvas." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder ziehe den Schatten direkt auf der Arbeitsfläche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou faites glisser l’ombre elle-même sur la zone de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure trascina l’ombra direttamente sull’area di lavoro."
          }
        }
      }
    },
    "Or drop a Bezzle, XD, Figma or Sketch file anywhere here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder lege irgendwo hier eine Bezzle-, XD-, Figma- oder Sketch-Datei ab"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou déposez un fichier Bezzle, XD, Figma ou Sketch n’importe où ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure trascina qui un file Bezzle, XD, Figma o Sketch"
          }
        }
      }
    },
    "Or pull the handles on its right and bottom edges, and drag between two cells to space them; Shift spaces them both ways." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder ziehe an den Griffen am rechten und unteren Rand, und ziehe zwischen zwei Zellen, um ihren Abstand zu ändern; mit der Umschalttaste in beide Richtungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou tirez les poignées de ses bords droit et inférieur, et faites glisser entre deux cellules pour les espacer ; Maj les espace dans les deux sens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure tira le maniglie sui bordi destro e inferiore, e trascina tra due celle per distanziarle; con Maiuscole le distanzi in entrambe le direzioni."
          }
        }
