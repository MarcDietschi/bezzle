            "state" : "translated",
            "value" : "Menu déroulant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu a discesa"
          }
        }
      }
    },
    "Duplicate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplizieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliquer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplica"
          }
        }
      }
    },
    "Duplicate Keys" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframes duplizieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliquer les images clés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplica fotogrammi chiave"
          }
        }
      }
    },
    "Duplicate Layers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebenen duplizieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliquer les calques"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplica livelli"
          }
        }
      }
    },
    "Duplicates whatever is selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliziert, was ausgewählt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplique ce qui est sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplica ciò che è selezionato."
          }
        }
      }
    },
    "Each cell's words and pictures are its own. Drop a text or CSV file on the grid, or a folder of pictures on a shape in it, to fill every cell at once; a CSV's columns go to the text layers named like them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte und Bilder hat jede Zelle für sich. Lege eine Text- oder CSV-Datei auf dem Raster ab oder einen Ordner mit Bildern auf einer Form darin, um alle Zellen auf einmal zu füllen; die Spalten einer CSV-Datei gehen an die gleichnamigen Textebenen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque cellule a ses propres textes et images. Déposez un fichier texte ou CSV sur la grille, ou un dossier d’images sur l’une de ses formes, pour remplir toutes les cellules d’un coup ; les colonnes d’un CSV vont aux calques de texte qui portent leur nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testi e immagini di ogni cella sono solo suoi. Trascina un file di testo o CSV sulla griglia, o una cartella di immagini su una sua forma, per riempire tutte le celle in una volta; le colonne di un CSV vanno ai livelli di testo con lo stesso nome."
          }
        }
      }
    },
    "Each file becomes a new design in your Bezzle folder. The file itself stays as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei wird zu einem neuen Design in deinem Bezzle-Ordner. Die Datei selbst bleibt unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier devient un nouveau design dans votre dossier Bezzle. Le fichier d’origine reste intact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni file diventa un nuovo design nella tua cartella Bezzle. Il file originale resta com’è."
          }
        }
      }
    },
    "Each of its colours now has a name and a dark look, made for you. Change one on the dark screen, and only its dark look changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede ihrer Farben hat jetzt einen Namen und einen dunklen Look, für dich gemacht. Ändere eine in der dunklen App, und nur ihr dunkler Look ändert sich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacune de ses couleurs a maintenant un nom et une apparence sombre, faite pour vous. Changez-en une sur l’écran sombre, et seule son apparence sombre change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno dei suoi colori ha ora un nome e un aspetto scuro, fatto per te. Cambiane uno sulla schermata scura, e cambia solo il suo aspetto scuro."
          }
        }
      }
    },
    "Each post an artboard" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Beitrag wird eine Zeichenfläche"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan de travail par publication"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tavola da disegno per post"
          }
        }
      }
    },
    "Each post has its own words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Beitrag hat eigene Worte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À chacune ses mots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni post ha le sue parole."
          }
        }
      }
    },
