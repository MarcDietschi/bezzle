            "state" : "translated",
            "value" : "An der Stelle, auf die du geklickt hast, hebt sich nichts ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne se détache à l’endroit choisi dans l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel punto scelto non c’è nulla che si stacchi dallo sfondo."
          }
        }
      }
    },
    "Now grab the shadow, not the tile, and drag it to move the light." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pack jetzt den Schatten, nicht die Kachel, und zieh ihn, um das Licht zu verschieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez maintenant l’ombre, pas le carreau, et faites-la glisser pour déplacer la lumière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora afferra l’ombra, non la piastrella, e trascinala per spostare la luce."
          }
        }
      }
    },
