    "hold me over the arch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "halt mich über den Bogen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tenez-moi sur l’arche"
          }
