    "Bezzle cannot connect right now. Your changes are kept and go out once it can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle kann gerade keine Verbindung herstellen. Deine Änderungen bleiben erhalten und gehen raus, sobald es wieder geht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle ne peut pas se connecter pour l’instant. Vos modifications sont conservées et partiront dès que possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle non riesce a connettersi ora. Le tue modifiche restano e partono appena possibile."
          }
        }
      }
    },
    "Bezzle cannot read Photoshop files in this colour mode yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photoshop-Dateien in diesem Farbmodus kann Bezzle noch nicht lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle ne peut pas encore lire les fichiers Photoshop dans ce mode colorimétrique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle non sa ancora leggere i file Photoshop in questo metodo colore."
          }
        }
      }
    },
    "Bezzle could not connect. Check the connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle konnte keine Verbindung herstellen. Prüfe die Verbindung und versuche es noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle n’a pas pu se connecter. Vérifiez la connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle non è riuscito a connettersi. Controlla la connessione e riprova."
          }
        }
      }
    },
    "Bezzle could not reach the design. Check the connection and open the link again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle konnte das Design nicht erreichen. Prüfe die Verbindung und öffne den Link noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
