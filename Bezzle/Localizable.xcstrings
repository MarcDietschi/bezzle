          }
        }
      }
    },
    "Press K and drag the knife straight across the lemon. Press V, then pull the halves apart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück K und zieh das Messer quer über die Zitrone. Drück V und zieh die Hälften auseinander."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur K et faites passer le cutter à travers le citron. Appuyez sur V, puis écartez les moitiés."
