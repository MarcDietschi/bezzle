          }
        }
      }
    },
    "How warm neutrals, soft depth and one honest accent make an interface feel considered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie warme Neutraltöne, sanfte Tiefe und ein ehrlicher Akzent eine Oberfläche durchdacht wirken lassen."
          }
        },
        "fr" : {
          "stringUnit" : {
