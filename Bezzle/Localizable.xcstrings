    "Open a card and point at the + beside its ×: the button tries on another. Click to keep it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Karte und zeig auf das + neben ihrem ×: Der Knopf probiert noch eine an. Klick, um sie zu behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une carte et survolez le + à côté de son × : le bouton en essaie une de plus. Cliquez pour la garder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri una scheda e passa sul + accanto alla ×: il pulsante ne prova un’altra. Fai clic per tenerla."
          }
        }
      }
    },
