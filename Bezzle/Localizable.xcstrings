            "value" : "Oppure trascina l’ombra direttamente sull’area di lavoro."
          }
        }
      }
    },
    "Or drop a Bezzle, XD, Figma or Sketch file anywhere here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder lege irgendwo hier eine Bezzle-, XD-, Figma- oder Sketch-Datei ab"
          }
        },
