    "A growing blur is sharp at the ring and blurs by the whole amount at the dot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zunehmende Unschärfe ist am Ring scharf und erreicht am Punkt die volle Stärke."
