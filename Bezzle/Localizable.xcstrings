    "Pull a corner of the sun to make it bigger. Hold ⇧ to keep it round." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an einer Ecke der Sonne, um sie zu vergrößern. Mit ⇧ bleibt sie rund."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez un coin du soleil pour l’agrandir. Avec ⇧, il reste rond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira un angolo del sole per ingrandirlo. Con ⇧ resta rotondo."
          }
        }
      }
    },
    "Pull the blue handle on its bottom edge downward. Every new card is a copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den blauen Griff an der Unterkante nach unten. Jede neue Karte ist eine Kopie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez vers le bas la poignée bleue de son bord inférieur. Chaque nouvelle carte est une copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira verso il basso la maniglia blu sul bordo inferiore. Ogni nuova scheda è una copia."
          }
        }
      }
    },
