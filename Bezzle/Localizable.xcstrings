      }
    },
    "Open the file, or drag it into Claude Desktop's Settings ▸ Extensions, to install it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Datei oder ziehe sie in Claude Desktop unter „Einstellungen“ ▸ „Erweiterungen“, um sie zu installieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le fichier, ou faites-le glisser dans Paramètres ▸ Extensions de Claude Desktop, pour l’installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri il file, o trascinalo in Impostazioni ▸ Estensioni di Claude Desktop, per installarlo."
          }
        }
      }
    },
    "Open…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
