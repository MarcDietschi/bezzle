          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezzle non è riuscito a raggiungere il design. Controlla la connessione e apri di nuovo il link."
          }
        }
      }
    },
    "Bezzle could not stop sharing “%@”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
