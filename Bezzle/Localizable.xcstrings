    "‹ and › in an open note go from one note to the next. A shared design carries everyone’s notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‹ und › in einer offenen Notiz führen von einer Notiz zur nächsten. Ein geteiltes Design trägt die Notizen aller."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‹ et › dans une note ouverte passent d’une note à la suivante. Un design partagé porte les notes de chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‹ e › in una nota aperta passano da una nota all’altra. Un design condiviso porta le note di tutti."
          }
        }
      }
    },
