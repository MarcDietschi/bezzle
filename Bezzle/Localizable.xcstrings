        }
      }
    },
    "Hold it while dragging to leave a copy behind." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ziehen gedrückt halten, um eine Kopie zurückzulassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
