          }
        }
      }
    },
    "Double-click the knob to lay the card flat again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Doppelklick auf den Knauf legt die Karte wieder flach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur le bouton pour remettre la carte à plat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sul pomello per rimettere la scheda in piano."
          }
        }
      }
    },
    "Double-click the photo to move or scale it inside the frame. The original is always kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf das Foto, um es im Rahmen zu verschieben oder zu skalieren. Das Original bleibt immer erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur la photo pour la déplacer ou la redimensionner dans le cadre. L’original est toujours conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sulla foto per spostarla o ridimensionarla nella cornice. L’originale resta sempre."
          }
        }
      }
    },
    "Double-click the recipe and drag across a few words to pick them. Change their colour, font or size in the inspector: only those letters change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf das Rezept, dann zieh über ein paar Wörter, um sie auszuwählen. Ändere im Inspektor Farbe, Schrift oder Größe: Nur diese Buchstaben ändern sich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur la recette et faites glisser sur quelques mots pour les choisir. Changez leur couleur, leur police ou leur taille dans l’inspecteur : seules ces lettres changent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sulla ricetta e trascina su qualche parola per sceglierla. Cambia colore, carattere o dimensione nell’ispettore: cambiano solo quelle lettere."
          }
        }
      }
    },
    "Double-click the sun: it is a layer of its own now, to recolour, reshape or move like any other." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf die Sonne: Sie ist jetzt eine eigene Ebene, die du umfärben, umformen und verschieben kannst wie jede andere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur le soleil : c’est maintenant un calque à part entière, à recolorer, remodeler ou déplacer comme n’importe quel autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sul sole: ora è un livello a sé, da ricolorare, rimodellare o spostare come qualsiasi altro."
          }
        }
      }
    },
    "Double-click to rename" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicken zum Umbenennen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez pour renommer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic per rinominare"
          }
        }
      }
    },
    "Double-click words on a curve to type: they straighten while you do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf Wörter auf einer Kurve, um zu tippen: Solange du schreibst, stehen sie gerade."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur des mots courbés pour écrire : ils se redressent le temps de la saisie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sulle parole curve per scrivere: mentre scrivi si raddrizzano."
          }
        }
      }
    },
    "Double, grooved and bevelled borders, drawn solid" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelte, gerillte und abgeschrägte Rahmen, durchgezogen gezeichnet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordures doubles, rainurées et biseautées, tracées pleines"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bordi doppi, scanalati e smussati, disegnati continui"
          }
        }
      }
    },
    "Down" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verticalement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In verticale"
          }
        }
      }
    },
    "Downloads" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargements"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download"
          }
        }
      }
    },
    "Draft" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwurf"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brouillon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bozza"
          }
        }
      }
    },
    "Drag a box around the three circles to select them, then press ⌥⌘B to build with their pieces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh einen Rahmen um die drei Kreise, um sie auszuwählen, und drück ⌥⌘B, um aus ihren Teilen zu bauen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracez un cadre autour des trois cercles pour les sélectionner, puis appuyez sur ⌥⌘B pour construire avec leurs morceaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un riquadro intorno ai tre cerchi per selezionarli, poi premi ⌥⌘B per costruire con i loro pezzi."
          }
        }
      }
    },
    "drag a box round us" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zieh einen Rahmen um uns"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "encadrez-nous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "circondaci con un riquadro"
          }
        }
      }
    },
    "Drag a card up or down its pile to lay it over or under the others." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh eine Karte nach oben oder unten, um sie über oder unter die anderen zu legen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une carte vers le haut ou le bas de sa pile pour la placer au-dessus ou en dessous des autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una scheda in su o in giù nella pila per metterla sopra o sotto le altre."
          }
        }
      }
    },
    "Drag a note’s pin to the button: its thread comes along. Talked it through? Tick it off with the round mark at its head." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Pin einer Notiz auf den Knopf: Ihr Faden kommt mit. Alles besprochen? Hak sie mit dem runden Zeichen oben in der Notiz ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’épingle d’une note sur le bouton : son fil suit. Tout est dit ? Cochez-la avec le rond en haut de la note."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina lo spillo di una nota sul pulsante: il suo filo lo segue. Tutto chiarito? Spuntala con il cerchio in alto nella nota."
          }
        }
      }
    },
    "Drag a photo of a person, a pet or a thing from the Finder or Photos onto the frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh ein Foto von einem Menschen, einem Tier oder einem Gegenstand aus dem Finder oder aus Fotos auf den Rahmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur le cadre une photo d’une personne, d’un animal ou d’un objet, depuis le Finder ou Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sulla cornice una foto di una persona, di un animale o di un oggetto, dal Finder o da Foto."
          }
        }
      }
    },
    "Drag a point or its handles. Click the outline to add a point, and double-click a point to make it smooth or sharp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Punkt oder seine Griffe. Klicke auf den Umriss, um einen Punkt hinzuzufügen, und doppelklicke auf einen Punkt, um ihn glatt oder spitz zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un point ou ses poignées. Cliquez sur le contour pour ajouter un point, et double-cliquez sur un point pour le rendre lisse ou anguleux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un punto o le sue maniglie. Fai clic sul contorno per aggiungere un punto, e fai doppio clic su un punto per renderlo smussato o d’angolo."
          }
        }
      }
    },
    "Drag a side of the text to wrap its words." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an einer Seite des Texts, um die Zeilen neu umzubrechen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un côté du texte pour renvoyer les mots à la ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un lato del testo per mandare a capo le parole."
          }
        }
      }
    },
    "Drag across pieces to join them into one shape, or click one to make it its own. Hold ⌥ to wipe pieces away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe über Teile, um sie zu einer Form zu verbinden, oder klicke auf eines, um es zu einer eigenen Form zu machen. Halte ⌥ gedrückt, um Teile wegzuwischen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur des morceaux pour les réunir en une seule forme, ou cliquez sur l’un d’eux pour l’isoler. Maintenez ⌥ pour effacer des morceaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sui pezzi per unirli in una forma, o fai clic su uno per renderlo a sé. Tieni premuto ⌥ per cancellare i pezzi."
          }
        }
      }
    },
    "Drag along the ruler, or swipe across it with two fingers: the poster goes back to how it was. Pencil marks show what has changed since." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh über das Lineal oder wisch mit zwei Fingern darüber: Das Poster wird wieder, wie es war. Bleistiftmarken zeigen, was sich seither geändert hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le long de la règle, ou balayez-la à deux doigts : l’affiche redevient ce qu’elle était. Des marques au crayon montrent ce qui a changé depuis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina lungo il righello, o scorri sopra con due dita: il poster torna com’era. I segni a matita mostrano cosa è cambiato da allora."
          }
        }
      }
    },
    "Drag an end to turn and stretch the gradient. Click a colour to pick it, drag it along to move it or away to take it off, or click the line to add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Ende, um den Verlauf zu drehen und zu strecken. Klicke auf eine Farbe, um sie auszuwählen, ziehe sie entlang der Linie, um sie zu verschieben, oder weg, um sie zu entfernen, oder klicke auf die Linie, um eine hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une extrémité pour faire pivoter et étirer le dégradé. Cliquez sur une couleur pour la choisir, faites-la glisser le long de la ligne pour la déplacer ou à l’écart pour la retirer, ou cliquez sur la ligne pour en ajouter une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un’estremità per ruotare e allungare la sfumatura. Fai clic su un colore per sceglierlo, trascinalo lungo la linea per spostarlo o lontano per rimuoverlo, oppure fai clic sulla linea per aggiungerne uno."
          }
        }
      }
    },
    "Drag as you click to pull a curve instead of a corner. Later, double-click any shape to move its points." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh beim Klicken, um statt einer Ecke eine Kurve zu formen. Später verschiebst du per Doppelklick die Punkte jeder Form."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser en cliquant pour tirer une courbe au lieu d’un angle. Plus tard, double-cliquez sur une forme pour déplacer ses points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina mentre fai clic per tirare una curva invece di un angolo. Poi, con un doppio clic su una forma, ne sposti i punti."
          }
        }
      }
    },
    "Drag from the ruler at the top or left onto the sheet to pull out a guide. Drag it back onto the ruler to put it away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh aus dem Lineal oben oder links eine Hilfslinie aufs Blatt. Zieh sie zurück aufs Lineal, um sie wegzuräumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser depuis la règle en haut ou à gauche sur la feuille pour tirer un repère. Ramenez-le sur la règle pour le ranger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina dal righello in alto o a sinistra sul foglio per tirare fuori una guida. Riportala sul righello per toglierla."
          }
        }
      }
    },
    "Drag on the canvas for a size of your own, or pick one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe auf der Arbeitsfläche für eine eigene Größe oder wähle eine aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur la zone de travail pour une taille sur mesure, ou choisissez-en une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sull’area di lavoro per una dimensione su misura, o scegline una."
          }
        }
      }
    },
    "Drag the card sideways and the screen goes on by itself, as a splash screen does." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Karte zur Seite, und der Screen geht von selbst weiter, wie ein Splash-Screen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la carte sur le côté et l’écran passe de lui-même au suivant, comme un écran de lancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la scheda di lato e la schermata prosegue da sola, come una schermata di avvio."
          }
        }
      }
    },
    "Drag the centre to move the gradient and its edge to turn and stretch it. The diamond on the ring widens it, and the one at the corner beyond it sizes it both ways, with Shift keeping its shape. Click a colour to pick it, or the line to add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Mitte, um den Verlauf zu verschieben, und seinen Rand, um ihn zu drehen und zu strecken. Die Raute auf dem Ring verbreitert ihn, und die Raute in der Ecke daneben ändert seine Größe in beide Richtungen, mit der Umschalttaste in gleicher Form. Klicke auf eine Farbe, um sie auszuwählen, oder auf die Linie, um eine hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le centre pour déplacer le dégradé, et son bord pour le faire pivoter et l’étirer. Le losange sur l’anneau l’élargit, et celui dans le coin au-delà le redimensionne dans les deux sens, Maj conservant sa forme. Cliquez sur une couleur pour la choisir, ou sur la ligne pour en ajouter une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il centro per spostare la sfumatura e il bordo per ruotarla e allungarla. Il rombo sull’anello la allarga e quello nell’angolo oltre l’anello la ridimensiona in entrambe le direzioni, con Maiusc per mantenerne la forma. Fai clic su un colore per sceglierlo, o sulla linea per aggiungerne uno."
          }
        }
      }
    },
    "Drag the corner for a size of your own" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an der Ecke für eine eigene Größe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez le coin pour une taille sur mesure"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’angolo per una misura tua"
          }
        }
      }
    },
    "Drag the knob on its face to aim it, as if you led it by the nose. Hold ⌥ to bring it nearer or push it away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Knauf auf ihrer Vorderseite, um sie auszurichten, als würdest du sie an der Nase führen. Mit ⌥ holst du sie näher oder schiebst sie weg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le bouton sur sa face pour l’orienter, comme si vous la meniez par le bout du nez. Avec ⌥, rapprochez-la ou éloignez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il pomello sulla sua faccia per orientarla, come se la guidassi per il naso. Con ⌥ la avvicini o la allontani."
          }
        }
      }
    },
    "Drag the label onto the edge of the badge and hold it still. After a moment the words jump onto it. Keep dragging to slide them round, to either side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Aufschrift auf den Rand des Badges und halt sie still. Nach einem Moment springen die Wörter darauf. Zieh weiter, um sie herumzuschieben, auf die eine oder andere Seite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’étiquette sur le bord du badge et tenez-la immobile. Au bout d’un instant, les mots sautent dessus. Continuez à glisser pour les faire tourner, d’un côté ou de l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’etichetta sul bordo del badge e tienila ferma. Dopo un attimo le parole ci saltano sopra. Continua a trascinare per farle scorrere, da un lato o dall’altro."
          }
        }
      }
    },
    "Drag the layer to place it on the artboard. It clicks to the edges and the middle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Ebene, um sie auf der Zeichenfläche zu platzieren. Sie rastet an den Rändern und in der Mitte ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le calque pour le placer sur le plan de travail. Il s’aligne sur les bords et au milieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il livello per posizionarlo sulla tavola da disegno. Si aggancia ai bordi e al centro."
          }
        }
      }
    },
    "Drag the photo over the arch and hold it still. After a moment the arch opens and takes the photo in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh das Foto über den Bogen und halt es still. Nach einem Moment öffnet sich der Bogen und nimmt das Foto auf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la photo sur l’arche et tenez-la immobile. Au bout d’un instant, l’arche s’ouvre et accueille la photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la foto sull’arco e tienila ferma. Dopo un attimo l’arco si apre e accoglie la foto."
          }
        }
      }
    },
    "Drag the picture to move it in its frame, or a corner to resize it. Option keeps its middle, and Return ends placing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe das Bild, um es in seiner Form zu verschieben, oder eine Ecke, um seine Größe zu ändern. Mit der Wahltaste bleibt die Mitte, wo sie ist; der Zeilenschalter beendet das Platzieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’image pour la déplacer dans son cadre, ou un coin pour la redimensionner. Option conserve son centre, et Retour termine le placement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’immagine per spostarla nella cornice, o un angolo per ridimensionarla. Opzione mantiene il centro e A capo termina il posizionamento."
          }
        }
      }
    },
    "Drag the ring, where it is sharp, or the dot, where the blur is whole; or drag across to draw it afresh. Double click to blur toward the bottom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe den Ring, wo alles scharf ist, oder den Punkt, wo die Unschärfe voll ist; oder ziehe quer darüber, um sie neu anzulegen. Doppelklicke, um nach unten hin weichzuzeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’anneau, là où l’image est nette, ou le point, là où le flou est total ; ou faites glisser en travers pour le redessiner. Double-cliquez pour flouter vers le bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’anello, dove è nitida, o il punto, dove la sfocatura è piena; oppure trascina attraverso per ridisegnarla. Fai doppio clic per sfocare verso il basso."
          }
        }
      }
    },
    "Drag the sun into the sky. When it lines up with something, a guide shows and it snaps into place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Sonne in den Himmel. Sobald sie an etwas ausgerichtet ist, erscheint eine Hilfslinie, und sie rastet ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le soleil dans le ciel. Dès qu’il s’aligne sur quelque chose, un repère apparaît et il se cale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il sole nel cielo. Quando si allinea a qualcosa, compare una guida e si aggancia."
          }
        }
      }
    },
    "Drag to aim it: the card faces where you point. Double click to lay it flat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um sie auszurichten: Die Karte blickt dorthin, wohin du zeigst. Doppelklicke, um sie flach hinzulegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour l’orienter : la carte se tourne vers l’endroit visé. Double-cliquez pour la remettre à plat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per orientarlo: la scheda si volge dove punti. Fai doppio clic per riportarlo in piano."
          }
        }
      }
    },
    "Drag to move this colour" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um diese Farbe zu verschieben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour déplacer cette couleur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per spostare questo colore"
          }
        }
      }
    },
    "Drag to move this colour, or off the bar to take it away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um diese Farbe zu verschieben, oder von der Leiste weg, um sie zu entfernen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour déplacer cette couleur, ou hors de la barre pour la supprimer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per spostare questo colore, o fuori dalla barra per rimuoverlo"
          }
        }
      }
    },
    "Drag to tip the scene back and swing it round under the camera. Double click to look straight down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um die Szene nach hinten zu kippen und unter der Kamera zu drehen. Doppelklicke, um senkrecht von oben zu schauen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour basculer la scène vers l’arrière et la faire tourner sous la caméra. Double-cliquez pour regarder à la verticale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per inclinare la scena all’indietro e farla ruotare sotto la camera. Fai doppio clic per guardare dritto dall’alto."
          }
        }
      }
    },
    "Drag up or down on the photo for more or less of the colour under the pointer, sideways to turn it. Click something white or grey to make it neutral." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh auf dem Foto nach oben oder unten für mehr oder weniger von der Farbe unter dem Zeiger, seitwärts, um sie zu drehen. Klick auf etwas Weißes oder Graues, um es neutral zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser vers le haut ou le bas sur la photo pour plus ou moins de la couleur sous le pointeur, sur le côté pour la faire tourner. Cliquez sur quelque chose de blanc ou de gris pour le rendre neutre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina in su o in giù sulla foto per avere più o meno del colore sotto il puntatore, di lato per ruotarlo. Fai clic su qualcosa di bianco o grigio per renderlo neutro."
          }
        }
      }
    },
    "Drag up or down on the photo to lighten or darken the tones under the pointer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh auf dem Foto nach oben oder unten, um die Töne unter dem Zeiger aufzuhellen oder abzudunkeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser vers le haut ou le bas sur la photo pour éclaircir ou assombrir les tons sous le pointeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina in su o in giù sulla foto per schiarire o scurire i toni sotto il puntatore."
          }
        }
      }
    },
    "Draw" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna"
          }
        }
      }
    },
    "Draw as One Card" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als eine Karte zeichnen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner comme une seule carte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna come un’unica scheda"
          }
        }
      }
    },
    "Draw the design  ⌃P" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Design zeichnen  ⌃P"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessiner le design  ⌃P"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna il design  ⌃P"
          }
        }
      }
    },
    "Drawings on a canvas, as pictures" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnungen auf einem Canvas, als Bilder"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessins sur un canevas, en images"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegni su un canvas, come immagini"
          }
        }
      }
    },
    "Drop a folder of photos or a text file on a grid to fill every card at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh einen Fotoordner oder eine Textdatei auf ein Raster, um alle Karten auf einmal zu füllen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez un dossier de photos ou un fichier texte sur une grille pour remplir toutes les cartes d’un coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una cartella di foto o un file di testo su una griglia per riempire tutte le schede in una volta."
          }
        }
      }
    },
    "Drop a photo from the Finder on the word. The photo shows through its letters, as it does in the word below, and they stay words you can type in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh ein Foto aus dem Finder auf das Wort. Das Foto scheint durch seine Buchstaben, wie im Wort darunter, und sie bleiben Text, in den du tippen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez une photo du Finder sur le mot. La photo apparaît à travers ses lettres, comme dans le mot en dessous, et elles restent des mots où vous pouvez écrire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una foto dal Finder sulla parola. La foto traspare dalle sue lettere, come nella parola qui sotto, e restano parole in cui puoi scrivere."
          }
        }
      }
    },
    "Drop a photo here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto hierher ziehen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez une photo ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina qui una foto"
          }
        }
      }
    },
    "Drop to open" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Öffnen loslassen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez pour ouvrir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilascia per aprire"
          }
        }
      }
    },
    "Dropdown Menu" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropdown-Menü"
          }
        },
        "fr" : {
