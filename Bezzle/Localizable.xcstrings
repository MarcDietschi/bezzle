    "This design is no longer shared with you. Save a copy of it to share that." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Design wird nicht mehr mit dir geteilt. Sichere eine Kopie davon, um diese zu teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce design n’est plus partagé avec vous. Enregistrez-en une copie pour partager celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo design non è più condiviso con te. Salvane una copia per condividere quella."
          }
        }
      }
    },
    "This design is shared through iCloud’s development environment, which this copy of Bezzle does not use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Design wird über die Entwicklungsumgebung von iCloud geteilt, die diese Bezzle-Version nicht verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce design est partagé via l’environnement de développement d’iCloud, que cette copie de Bezzle n’utilise pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo design è condiviso tramite l’ambiente di sviluppo di iCloud, che questa copia di Bezzle non usa."
          }
        }
      }
    },
    "This design is shared through iCloud’s production environment, which this copy of Bezzle does not use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Design wird über die Produktionsumgebung von iCloud geteilt, die diese Bezzle-Version nicht verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce design est partagé via l’environnement de production d’iCloud, que cette copie de Bezzle n’utilise pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo design è condiviso tramite l’ambiente di produzione di iCloud, che questa copia di Bezzle non usa."
          }
        }
      }
    },
    "This design was shared by a later Bezzle. Update Bezzle to share it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Design wurde mit einer neueren Bezzle-Version geteilt. Aktualisiere Bezzle, um es zu teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce design a été partagé par une version plus récente de Bezzle. Mettez Bezzle à jour pour le partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo design è stato condiviso da una versione più recente di Bezzle. Aggiorna Bezzle per condividerlo."
          }
        }
      }
    },
    "This file is not a ZIP archive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist kein ZIP-Archiv."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas une archive ZIP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file non è un archivio ZIP."
          }
        }
      }
    },
    "This file was saved by a Sketch older than version 43, which Bezzle cannot read. Open it in a newer Sketch, save it again, and bring that in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei wurde mit einer Sketch-Version vor 43 gesichert, die Bezzle nicht lesen kann. Öffne sie in einem neueren Sketch, sichere sie erneut und importiere dann diese Datei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a été enregistré par une version de Sketch antérieure à la 43, que Bezzle ne peut pas lire. Ouvrez-le dans une version plus récente de Sketch, enregistrez-le à nouveau, puis importez ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file è stato salvato con una versione di Sketch precedente alla 43, che Bezzle non può leggere. Aprilo in una versione più recente di Sketch, salvalo di nuovo e importa quello."
          }
        }
      }
    },
