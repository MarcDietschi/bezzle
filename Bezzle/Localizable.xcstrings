    "Change one card, its colour or its size, and they all follow. The words in each stay their own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere eine Karte, ihre Farbe oder ihre Größe, und alle folgen. Die Texte bleiben in jeder Karte ihre eigenen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez une carte, sa couleur ou sa taille, et toutes suivent. Les textes de chacune restent les siens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia una scheda, il colore o la dimensione, e tutte la seguono. I testi di ognuna restano suoi."
          }
        }
      }
    },
