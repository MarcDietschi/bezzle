    },
    "These three buttons are copies of one component. Click one, then click its shape and give it another colour. The others take it as the light reaches them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese drei Buttons sind Kopien einer Komponente. Klicke einen an, dann seine Form, und gib ihr eine andere Farbe. Die anderen übernehmen sie, sobald das Licht sie erreicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces trois boutons sont des copies d’un même composant. Cliquez-en un, puis sur sa forme, et donnez-lui une autre couleur. Les autres la prennent dès que la lumière les atteint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi tre pulsanti sono copie di un solo componente. Fai clic su uno, poi sulla sua forma, e dalle un altro colore. Gli altri lo prendono non appena la luce li raggiunge."
          }
        }
      }
    },
