    },
    "OpenType features of the font: figures, ligatures, stylistic sets" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenType-Funktionen der Schrift: Ziffern, Ligaturen, Stilsätze"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
