    "What you change here changes in all %lld cells, but for the picture: each cell has its own." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Was du hier änderst, ändert sich in der einen Zelle, außer dem Bild: Das hat jede Zelle für sich."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Was du hier änderst, ändert sich in allen %lld Zellen, außer dem Bild: Das hat jede Zelle für sich."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ce que vous modifiez ici s’applique à %lld cellule, sauf l’image : chaque cellule a la sienne."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ce que vous modifiez ici s’applique aux %lld cellules, sauf l’image : chaque cellule a la sienne."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ciò che modifichi qui cambia in %lld cella, tranne l’immagine: ogni cella ha la sua."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ciò che modifichi qui cambia in tutte le %lld celle, tranne l’immagine: ogni cella ha la sua."
