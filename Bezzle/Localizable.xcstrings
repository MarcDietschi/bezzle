    },
    "Hold it and drag to move around, or just scroll" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedrückt halten und ziehen, um dich zu bewegen, oder einfach scrollen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
