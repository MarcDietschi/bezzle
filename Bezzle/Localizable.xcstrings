    "That’s the tour. Press ⌘N for a design of your own. Help › Welcome to Bezzle brings back a fresh copy of this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war die Tour. Mit ⌘N beginnst du ein eigenes Design. Unter Hilfe › Willkommen bei Bezzle gibt es jederzeit eine frische Kopie davon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la fin de la visite. Appuyez sur ⌘N pour créer votre propre design. Aide › Bienvenue dans Bezzle en rouvre une copie neuve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tour è finito. Premi ⌘N per un design tutto tuo. Aiuto › Primi passi con Bezzle ne riapre una copia nuova."
          }
        }
      }
    },
