    "Click a subject to keep or drop it. Drag the picture to move it in its frame, or a corner to resize it, and Return ends placing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf ein Motiv, um es zu behalten oder wegzulassen. Ziehe das Bild, um es in seiner Form zu verschieben, oder eine Ecke, um seine Größe zu ändern; der Zeilenschalter beendet das Platzieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur un sujet pour le conserver ou le retirer. Faites glisser l’image pour la déplacer dans son cadre, ou un coin pour la redimensionner ; Retour termine le placement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un soggetto per tenerlo o scartarlo. Trascina l’immagine per spostarla nella cornice, o un angolo per ridimensionarla; A capo termina il posizionamento."
          }
        }
      }
    },
