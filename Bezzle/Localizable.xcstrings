    "Duplicates whatever is selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliziert, was ausgewählt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplique ce qui est sélectionné."
          }
        },
