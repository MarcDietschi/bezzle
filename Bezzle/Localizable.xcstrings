    "H.264" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264"
          }
        }
      }
    },
    "H.264 plays everywhere. HEVC with 10 bits keeps gentle gradients, soft shadows and slow fades smooth where H.264 shows bands, and plays on Apple devices and in most browsers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 läuft überall. HEVC mit 10 Bit hält sanfte Verläufe, weiche Schatten und langsames Einblenden glatt, wo H.264 Streifen zeigt, und läuft auf Apple-Geräten und in den meisten Browsern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 se lit partout. HEVC en 10 bits garde lisses les dégradés doux, les ombres diffuses et les fondus lents, là où H.264 montre des bandes, et se lit sur les appareils Apple et dans la plupart des navigateurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H.264 si vede ovunque. HEVC a 10 bit mantiene uniformi le sfumature delicate, le ombre morbide e le dissolvenze lente, dove H.264 mostra bande, e si vede sui dispositivi Apple e nella maggior parte dei browser."
          }
        }
      }
    },
    "Hard Light" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartes Licht"
