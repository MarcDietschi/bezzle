            "value" : "Puntini"
          }
        }
      }
    },
    "double-click me" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "doppelklick mich"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "double-cliquez ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "doppio clic qui"
          }
        }
      }
    },
    "Double-click the headline on the poster and type something of your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf die Schlagzeile im Poster, und schreib etwas Eigenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur le titre de l’affiche et tapez votre propre texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sul titolo del poster e scrivi qualcosa di tuo."
          }
        }
      }
    },
    "Double-click the knob to lay the card flat again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Doppelklick auf den Knauf legt die Karte wieder flach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur le bouton pour remettre la carte à plat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sul pomello per rimettere la scheda in piano."
          }
        }
      }
    },
    "Double-click the photo to move or scale it inside the frame. The original is always kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklick auf das Foto, um es im Rahmen zu verschieben oder zu skalieren. Das Original bleibt immer erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur la photo pour la déplacer ou la redimensionner dans le cadre. L’original est toujours conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic sulla foto per spostarla o ridimensionarla nella cornice. L’originale resta sempre."
          }
        }
      }
    },
    "Down" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verticalement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In verticale"
          }
        }
      }
    },
    "Drag a box around the three circles to select them, then press ⌥⌘B to build with their pieces." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh einen Rahmen um die drei Kreise, um sie auszuwählen, und drück ⌥⌘B, um aus ihren Teilen zu bauen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracez un cadre autour des trois cercles pour les sélectionner, puis appuyez sur ⌥⌘B pour construire avec leurs morceaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un riquadro intorno ai tre cerchi per selezionarli, poi premi ⌥⌘B per costruire con i loro pezzi."
          }
        }
      }
    },
    "drag a box round us" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zieh einen Rahmen um uns"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "encadrez-nous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "circondaci con un riquadro"
          }
        }
      }
    },
    "Drag a photo of a person, a pet or a thing from the Finder or Photos onto the frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh ein Foto von einem Menschen, einem Tier oder einem Gegenstand aus dem Finder oder aus Fotos auf den Rahmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur le cadre une photo d’une personne, d’un animal ou d’un objet, depuis le Finder ou Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sulla cornice una foto di una persona, di un animale o di un oggetto, dal Finder o da Foto."
          }
        }
      }
    },
    "Drag a point or its handles. Click the outline to add a point, and double-click a point to make it smooth or sharp." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Punkt oder seine Griffe. Klicke auf den Umriss, um einen Punkt hinzuzufügen, und doppelklicke auf einen Punkt, um ihn glatt oder spitz zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un point ou ses poignées. Cliquez sur le contour pour ajouter un point, et double-cliquez sur un point pour le rendre lisse ou anguleux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un punto o le sue maniglie. Fai clic sul contorno per aggiungere un punto, e fai doppio clic su un punto per renderlo smussato o d’angolo."
          }
        }
      }
    },
    "Drag a side of the text to wrap its words. Drag its top or bottom to make the letters bigger or smaller." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an einer Seite des Texts, um die Zeilen neu umzubrechen. Zieh oben oder unten, um die Buchstaben größer oder kleiner zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser un côté du texte pour renvoyer les mots à la ligne. Faites glisser le haut ou le bas pour agrandir ou réduire les lettres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un lato del testo per mandare a capo le parole. Trascina sopra o sotto per ingrandire o rimpicciolire le lettere."
          }
        }
      }
    },
    "Drag across pieces to join them into one shape, or click one to make it its own. Hold ⌥ to wipe pieces away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe über Teile, um sie zu einer Form zu verbinden, oder klicke auf eines, um es zu einer eigenen Form zu machen. Halte ⌥ gedrückt, um Teile wegzuwischen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur des morceaux pour les réunir en une seule forme, ou cliquez sur l’un d’eux pour l’isoler. Maintenez ⌥ pour effacer des morceaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sui pezzi per unirli in una forma, o fai clic su uno per renderlo a sé. Tieni premuto ⌥ per cancellare i pezzi."
          }
        }
      }
    },
    "Drag an end to turn and stretch the gradient. Click a colour to pick it, drag it along to move it or away to take it off, or click the line to add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Ende, um den Verlauf zu drehen und zu strecken. Klicke auf eine Farbe, um sie auszuwählen, ziehe sie entlang der Linie, um sie zu verschieben, oder weg, um sie zu entfernen, oder klicke auf die Linie, um eine hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une extrémité pour faire pivoter et étirer le dégradé. Cliquez sur une couleur pour la choisir, faites-la glisser le long de la ligne pour la déplacer ou à l’écart pour la retirer, ou cliquez sur la ligne pour en ajouter une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un’estremità per ruotare e allungare la sfumatura. Fai clic su un colore per sceglierlo, trascinalo lungo la linea per spostarlo o lontano per rimuoverlo, oppure fai clic sulla linea per aggiungerne uno."
          }
        }
      }
    },
    "Drag as you click to pull a curve instead of a corner. Later, double-click any shape to move its points." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh beim Klicken, um statt einer Ecke eine Kurve zu formen. Später verschiebst du per Doppelklick die Punkte jeder Form."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser en cliquant pour tirer une courbe au lieu d’un angle. Plus tard, double-cliquez sur une forme pour déplacer ses points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina mentre fai clic per tirare una curva invece di un angolo. Poi, con un doppio clic su una forma, ne sposti i punti."
          }
        }
      }
    },
    "Drag on the canvas for a size of your own, or pick one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe auf der Arbeitsfläche für eine eigene Größe oder wähle eine aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur la zone de travail pour une taille sur mesure, ou choisissez-en une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sull’area di lavoro per una dimensione su misura, o scegline una."
          }
        }
      }
    },
    "Drag the centre to move the gradient, its edge to turn and stretch it, and the point on the ring to widen it. Click a colour to pick it, or the line to add one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Mitte, um den Verlauf zu verschieben, seinen Rand, um ihn zu drehen und zu strecken, und den Punkt auf dem Ring, um ihn zu verbreitern. Klicke auf eine Farbe, um sie auszuwählen, oder auf die Linie, um eine hinzuzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le centre pour déplacer le dégradé, son bord pour le faire pivoter et l’étirer, et le point sur l’anneau pour l’élargir. Cliquez sur une couleur pour la choisir, ou sur la ligne pour en ajouter une."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il centro per spostare la sfumatura, il bordo per ruotarla e allungarla, e il punto sull’anello per allargarla. Fai clic su un colore per sceglierlo, o sulla linea per aggiungerne uno."
          }
        }
      }
    },
    "Drag the corner for a size of your own" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh an der Ecke für eine eigene Größe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez le coin pour une taille sur mesure"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’angolo per una misura tua"
          }
        }
      }
    },
    "Drag the knob on its face to aim it, as if you led it by the nose. Hold ⌥ to bring it nearer or push it away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh den Knauf auf ihrer Vorderseite, um sie auszurichten, als würdest du sie an der Nase führen. Mit ⌥ holst du sie näher oder schiebst sie weg."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le bouton sur sa face pour l’orienter, comme si vous la meniez par le bout du nez. Avec ⌥, rapprochez-la ou éloignez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il pomello sulla sua faccia per orientarla, come se la guidassi per il naso. Con ⌥ la avvicini o la allontani."
          }
        }
      }
    },
    "Drag the layer to place it on the artboard. It clicks to the edges and the middle." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Ebene, um sie auf der Zeichenfläche zu platzieren. Sie rastet an den Rändern und in der Mitte ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le calque pour le placer sur le plan de travail. Il s’aligne sur les bords et au milieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il livello per posizionarlo sulla tavola da disegno. Si aggancia ai bordi e al centro."
          }
        }
      }
    },
    "Drag the picture to move it in its frame, or a corner to resize it. Option keeps its middle, and Return ends placing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe das Bild, um es in seiner Form zu verschieben, oder eine Ecke, um seine Größe zu ändern. Mit der Wahltaste bleibt die Mitte, wo sie ist; der Zeilenschalter beendet das Platzieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’image pour la déplacer dans son cadre, ou un coin pour la redimensionner. Option conserve son centre, et Retour termine le placement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’immagine per spostarla nella cornice, o un angolo per ridimensionarla. Opzione mantiene il centro e A capo termina il posizionamento."
          }
        }
      }
    },
    "Drag the ring, where it is sharp, or the dot, where the blur is whole; or drag across to draw it afresh. Double click to blur toward the bottom." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe den Ring, wo alles scharf ist, oder den Punkt, wo die Unschärfe voll ist; oder ziehe quer darüber, um sie neu anzulegen. Doppelklicke, um nach unten hin weichzuzeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser l’anneau, là où l’image est nette, ou le point, là où le flou est total ; ou faites glisser en travers pour le redessiner. Double-cliquez pour flouter vers le bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina l’anello, dove è nitida, o il punto, dove la sfocatura è piena; oppure trascina attraverso per ridisegnarla. Fai doppio clic per sfocare verso il basso."
          }
        }
      }
    },
    "Drag the sun into the sky. When it lines up with something, a guide shows and it snaps into place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Sonne in den Himmel. Sobald sie an etwas ausgerichtet ist, erscheint eine Hilfslinie, und sie rastet ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser le soleil dans le ciel. Dès qu’il s’aligne sur quelque chose, un repère apparaît et il se cale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina il sole nel cielo. Quando si allinea a qualcosa, compare una guida e si aggancia."
          }
        }
      }
    },
    "Drag to aim it: the card faces where you point. Double click to lay it flat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um sie auszurichten: Die Karte blickt dorthin, wohin du zeigst. Doppelklicke, um sie flach hinzulegen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour l’orienter : la carte se tourne vers l’endroit visé. Double-cliquez pour la remettre à plat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per orientarlo: la scheda si volge dove punti. Fai doppio clic per riportarlo in piano."
          }
        }
      }
    },
    "Drag to move this colour, or off the bar to take it away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe, um diese Farbe zu verschieben, oder von der Leiste weg, um sie zu entfernen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour déplacer cette couleur, ou hors de la barre pour la supprimer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per spostare questo colore, o fuori dalla barra per rimuoverlo"
          }
        }
      }
    },
    "Draw" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnen"
          }
        },
        "fr" : {
