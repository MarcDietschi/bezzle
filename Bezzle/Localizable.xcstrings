        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che si vede oltre i bordi della tavola da disegno quando la camera li inquadra"
          }
        }
      }
    },
    "What the component is called" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
