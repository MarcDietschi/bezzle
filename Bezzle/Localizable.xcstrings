    "How closely the outlines follow every turn of the picture" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie genau die Umrisse jeder Wendung des Bildes folgen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À quel point les contours suivent chaque détour de l’image"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto fedelmente i contorni seguono ogni curva dell’immagine"
          }
