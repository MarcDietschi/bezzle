          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienilo premuto mentre trascini per lasciare una copia."
          }
        }
      }
    },
    "hold me on its edge" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "halt mich an den Rand"
          }
        },
