    "A pencil goes over the picture, and it comes back as shapes. Drag sideways across its Vector card in the inspector: the shapes keep more or less of the picture’s detail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bleistift fährt über das Bild, und es kommt als Formen zurück. Zieh im Inspektor seitwärts über seine Karte Vektor: Die Formen behalten mehr oder weniger von den Details des Bilds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un crayon passe sur l’image, qui revient en formes. Faites glisser latéralement sur sa carte Vecteur dans l’inspecteur : les formes gardent plus ou moins de détails de l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una matita passa sull’immagine, che torna fatta di forme. Trascina di lato sulla sua scheda Vettore nell’ispettore: le forme tengono più o meno dettagli dell’immagine."
          }
        }
      }
    },
