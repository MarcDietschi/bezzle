    "Double-click a label and type. The words are each copy's own, and its button grows round them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke eine Beschriftung und tippe. Die Wörter gehören jeder Kopie selbst, und ihr Button wächst um sie herum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-cliquez sur un libellé et tapez. Les mots sont propres à chaque copie, et son bouton s’agrandit autour d’eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai doppio clic su un’etichetta e scrivi. Le parole sono proprie di ogni copia, e il suo pulsante cresce attorno a loro."
          }
        }
      }
    },
