    "Draw an artboard with A, or a shape with R, E or L." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe mit A eine Zeichenfläche auf oder mit R, E oder L eine Form."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez un plan de travail avec A, ou une forme avec R, E ou L."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una tavola da disegno con A, o disegna una forma con R, E o L."
          }
        }
      }
    },
    "Drop a folder of photos or a text file on a grid to fill every card at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh einen Fotoordner oder eine Textdatei auf ein Raster, um alle Karten auf einmal zu füllen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez un dossier de photos ou un fichier texte sur une grille pour remplir toutes les cartes d’un coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una cartella di foto o un file di testo su una griglia per riempire tutte le schede in una volta."
          }
        }
      }
    },
    "Drop a photo here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
