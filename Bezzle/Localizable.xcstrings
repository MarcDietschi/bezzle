    "Change a colour again and click New Variant in the word that comes up. The variants lie beside a selected button, to switch between." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere noch einmal eine Farbe und klicke im Hinweis, der erscheint, auf Neue Variante. Die Varianten liegen neben einem ausgewählten Button, zum Wechseln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez encore une couleur et cliquez sur Nouvelle variante dans le message qui apparaît. Les variantes se trouvent à côté d’un bouton sélectionné, pour passer de l’une à l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia ancora un colore e fai clic su Nuova variante nel messaggio che compare. Le varianti stanno accanto a un pulsante selezionato, per passare dall’una all’altra."
          }
        }
      }
    },
