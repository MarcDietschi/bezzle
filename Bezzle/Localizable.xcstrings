    "Every sheet below is a real design. Move things, change them, break them: ⌘Z puts it all back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Blatt hier unten ist ein echtes Design. Verschieb Dinge, ändere sie, mach sie kaputt: ⌘Z bringt alles zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque feuille ci-dessous est un vrai design. Déplacez, modifiez, cassez à votre guise : ⌘Z remet tout en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni foglio qui sotto è un vero design. Sposta le cose, cambiale, rompile: ⌘Z rimette tutto a posto."
          }
        }
      }
    },
    "Everything came across as it is." : {
