          "stringUnit" : {
            "state" : "translated",
            "value" : "Was beide Screens teilen, bewegt sich; der Rest ändert sich drumherum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que les deux écrans partagent se déplace ; le reste change autour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che le due schermate condividono si muove; il resto cambia intorno."
          }
        }
      }
    },
    "What shows past the artboard's edges when the camera sees them" : {
      "localizations" : {
        "de" : {
