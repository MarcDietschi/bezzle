      }
    },
    "How far a spring goes past its key before it comes to rest" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit eine Feder über ihren Keyframe hinausschwingt, bevor sie zur Ruhe kommt"
          }
