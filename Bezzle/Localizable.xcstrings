        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a été enregistré par une version de Sketch antérieure à la 43, que Bezzle ne peut pas lire. Ouvrez-le dans une version plus récente de Sketch, enregistrez-le à nouveau, puis importez ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
